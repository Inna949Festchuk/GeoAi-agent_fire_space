# Database
POSTGRES_DB=fire_monitor
POSTGRES_USER=fire_user
POSTGRES_PASSWORD=fire_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# LLM API (for chat)
LLM_API_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=qwen/qwen3.7-plus

# NASA FIRMS API (get key at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_API_KEY=your-firms-api-key

# Sandbox (for execute_python tool)
SANDBOX_URL=http://sandbox:8002/execute

# Burn mapping (multi-tile Sentinel-2 dNBR)
BURN_MAX_TILES=16
BURN_SCENE_WINDOW_DAYS=15
BURN_PARALLEL_TILES=3
BURN_RETRY_DELAYS=15,30,60
# dNBR severity thresholds (x1000): low <300, moderate 300-500, high >500
# (USGS standard 270/440 is the documented reference; 300/500 is the
# calibrated default for July 2024 Irkutsk — less phenology dilution)
BURN_DNBR_LOW_MAX=300
BURN_DNBR_MOD_MAX=500
# Jobs stuck in "running" longer than this (minutes) are marked failed
# (sweep on backend startup + duplicate-run guard). Default 120.
JOB_TIMEOUT_MINUTES=120

# Validation (run_validation): Strela vs Rosleskhoz / NASA MCD64A1
VAL_BUFFER_METERS=500
VAL_DETECTION_WINDOW_DAYS=3
# MCD64A1 is a monthly composite — wider window than for detection
VAL_BURN_WINDOW_DAYS=20
# Geodesic buffer (m) around Strela burn polygons in the raster comparison
VAL_BURN_BUFFER_METERS=1000
# Severity classes compared (low = mostly phenology, filtered out)
VAL_BURN_SEVERITIES=moderate,high
# Minimum burn polygon area (ha) — tiny polygons are noise
VAL_MIN_BURN_AREA_HA=500
# STAC API (Planetary Computer) HTTP timeouts, sec: connect, read.
# Without read timeout a stalled socket hangs a burn job forever.
STAC_CONNECT_TIMEOUT=15
STAC_READ_TIMEOUT=120

# GDAL HTTP (загрузка удалённых растров): таймауты соединения/чтения, сек
GDAL_HTTP_CONNECTTIMEOUT=30
GDAL_HTTP_TIMEOUT=300

# Frontend
VITE_API_URL=http://localhost:8000

# NASA GOV
EARTHDATA_TOKEN=nasa_gov_tocken
